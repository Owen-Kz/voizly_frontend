<link rel="stylesheet" href="/css/contact.css">

<div class="contact-wrapper fade-slide-in">
    <div class="contact-form">
      <h2>Send Us a Message. </h2>
      <form action="/submit-form" method="POST">
        <input type="text" name="name" placeholder="Your Name" required />
        <input type="email" name="email" placeholder="Your Email" required />
        <textarea name="message" placeholder="Tell us more..." required></textarea>
        <button type="submit" class="cta-btn"><span>Send to Us!</span></button>
      </form>
    </div>
    <div class="contact-info">
      <h2>Drop in Our Office.</h2>
      <p>Our office is located in Ikoyi, Lagos. Beside the FIRS office Keffi street</p>
      <p><strong>Ikoyi-Obalander, Lagos</strong><br />
        27, Biaduo street, Ikoyi Obalende,<br />
        Lagos, Nigeria
      </p>
      <p>
        <i class="fa fa-envelope"></i> voizly@weperch.live<br />
        <i class="fa fa-phone"></i> (+84) 83-559-0006</p>
      <div class="social-icons">
        <a href="#"><i class="fab fa-facebook"></i></a>
        <a href="#"><i class="fab fa-twitter"></i></a>
        <a href="#"><i class="fab fa-linkedin"></i></a>
      </div>
    </div>
  </div>
  